#!/usr/bin/env bash
# Editions launcher (ISO live session): fixed notice + title + info text on top, banner fitted below

LIST_URL="https://raw.githubusercontent.com/EndeavourOS-Community-Editions/editions-list/refs/heads/main/editions.md"
DEST="$HOME/user_commands.bash"   # where the edition script is saved
WIN_W=640            # fixed window width
WIN_H=900            # fixed window height
INFO_MAX_CHARS=300   # maximum length of the edition info text
TEXT_WIDTH=80        # characters per line before wrapping
TITLE_SIZE="xx-large"

# Fixed notice (Pango markup, hand-wrapped to fit the window width)
read -r -d '' NOTICE <<'EOF'
The <a href="https://github.com/EndeavourOS-Community-Editions">EndeavourOS Community Editions</a> repository lists current
community-maintained editions.
Using the "Add Edition to Installer" option executes a script that
integrates the selected edition into the installer and sets up the
user configuration.

Only a single community edition can be added at a time. Subsequent
additions will overwrite previous selections.

<b>Installation Procedure:</b>
1. Return to the Welcome app.
2. Click Start the Installer and proceed with an online installation.
3. Select "no desktop" on the Desktop Environment (DE) selection screen.

<b>Disclaimer:</b> These editions consist of user-contributed content and
are not officially controlled, maintained, or endorsed by the EndeavourOS
core team. The use of this tool is at your own risk and without any
warranty or guarantee.
EOF

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# --- Add an edition to the installer -------------------------------------
# $1 = edition name, $2 = raw isomode script URL
# Downloads the script to $DEST, makes it executable (not run) and confirms.
# Returns 0 on success, 1 on failure.
add_to_installer() {
    local name="$1" url="$2"

    [[ -e $DEST ]] && cp -f "$DEST" "$DEST.bak"

    if curl -fsSL "$url" -o "$DEST.tmp" && [[ -s $DEST.tmp ]]; then
        mv -f "$DEST.tmp" "$DEST"
        chmod +x "$DEST"
        yad --image=dialog-information --title="Done" --center --no-markup \
            --text="$name successfully added to installer." --button="OK:0"
        return 0
    else
        rm -f "$DEST.tmp"
        yad --image=dialog-error --title="Error" --center --no-markup \
            --text="Could not add $name to installer.\n\nDownload failed:\n$url" \
            --button="OK:0"
        return 1
    fi
}

# --- Fetch the list ----------------------------------------------------
if ! content=$(curl -fsSL "$LIST_URL" 2>&1); then
    yad --image=dialog-error --title="Error" --no-markup \
        --text="Could not load the editions list:\n\n${content}" --button="OK:0"
    exit 1
fi

# --- Parse --------------------------------------------------------------
# stdout: Name|SourcesURL|IsomodeURL|ImageURL   (one line per edition)
# file:   $tmp/info.<index>                     (info text)
mapfile -t editions < <(
    tr -d '\r' <<< "$content" | awk -v dir="$tmp" -v maxl=1000 '
        function first_url(s) {
            if (match(s, /https?:\/\/[^ )>\]]+/)) return substr(s, RSTART, RLENGTH)
            return ""
        }
        function clean(s,   t, lbl) {
            gsub(/\*\*/, "", s)
            while (match(s, /\[[^]]*\]\([^)]*\)/)) {
                t = substr(s, RSTART, RLENGTH)
                lbl = t; sub(/^\[/, "", lbl); sub(/\].*$/, "", lbl)
                s = substr(s, 1, RSTART-1) lbl substr(s, RSTART+RLENGTH)
            }
            sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s)
            return s
        }
        function add(s) {
            if (ni < maxl)     info[++ni] = s
            else if (!trunc) { info[maxl] = info[maxl] " …"; trunc = 1 }
        }
        function flush(   f, k) {
            if (name != "" && iso != "") {
                print name "|" src "|" iso "|" img
                while (ni > 0 && info[ni] == "") ni--
                if (ni > 0) {
                    f = dir "/info." cnt
                    for (k = 1; k <= ni; k++) print info[k] > f
                    close(f)
                }
                cnt++
            }
            name = src = iso = img = ""; ni = 0; trunc = 0; ininfo = 0
        }
        BEGIN { cnt = 0 }
        /^#+[ \t]+/ { flush(); n = $0; sub(/^#+[ \t]+/, "", n); name = n; next }
        /<img /     { if (match($0, /src="[^"]+"/)) img = substr($0, RSTART+5, RLENGTH-6); ininfo = 0; next }
        tolower($0) ~ /link to sources/     { src = first_url($0); ininfo = 0; next }
        tolower($0) ~ /isomode script link/ { iso = first_url($0); ininfo = 0; next }
        /^[ \t]*(---+|\*\*\*+)[ \t]*$/      { ininfo = 0; next }
        tolower($0) ~ /^[ \t]*\*\*info:?\*\*/ {
            ininfo = 1
            s = $0; sub(/^[ \t]*\*\*[Ii][Nn][Ff][Oo]:?\*\*:?[ \t]*/, "", s)
            s = clean(s)
            if (s != "") add(s)
            next
        }
        /^[ \t]*$/ { if (ininfo && ni > 0 && info[ni] != "") add(""); next }
        { if (ininfo && name != "") add(clean($0)) }
        END { flush() }'
)

if ((${#editions[@]} == 0)); then
    yad --image=dialog-error --title="Error" \
        --text="No editions found in the list (format changed?)." --button="OK:0"
    exit 1
fi

# --- Fill arrays, download banners in parallel ---------------------------
names=(); srcs=(); isos=(); imgs=()
i=0
for e in "${editions[@]}"; do
    IFS='|' read -r name src iso imgurl <<< "$e"
    names+=("$name"); srcs+=("$src"); isos+=("$iso"); imgs+=("$tmp/img.$i")
    [[ -n $imgurl ]] && curl -fsSL -o "$tmp/img.$i" "$imgurl" 2>/dev/null &
    ((i++))
done
wait

# --- Display loop --------------------------------------------------------
n=${#names[@]}
cur=0
while :; do
    text="${NOTICE}"$'\n\n'
    text+="<span size=\"$TITLE_SIZE\" weight=\"bold\">${names[cur]}</span>  <span foreground=\"gray\">($((cur + 1))/$n)</span>"

    if [[ -s $tmp/info.$cur ]]; then
        # Join lines, truncate at a word boundary, escape markup, wrap
        info="$(tr '\n' ' ' < "$tmp/info.$cur" | sed 's/  */ /g; s/^ //; s/ $//')"
        if ((${#info} > INFO_MAX_CHARS)); then
            info="${info:0:INFO_MAX_CHARS}"
            info="${info% *} …"
        fi
        info="$(sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<< "$info" | fold -s -w "$TEXT_WIDTH")"
        text+=$'\n\n'"$info"
    fi

    args=(
        --title="EndeavourOS Community Editions"
        --width="$WIN_W" --height="$WIN_H" --fixed --center
        --text="$text" --uri-handler="firefox %s"
        --button="Back!go-previous:10"
        --button="Open sources!web-browser:11"
        --button="Add ${names[cur]} to installer!list-add:12"
        --button="Next!go-next:13"
        --button="Close!window-close:0"
    )
    # Banner fitted into the remaining space
    [[ -s ${imgs[cur]} ]] && args+=(--picture --filename="${imgs[cur]}" --size=fit)

    yad "${args[@]}"
    case $? in
        10) cur=$(( (cur - 1 + n) % n )) ;;
        13) cur=$(( (cur + 1) % n )) ;;
        11) firefox "${srcs[cur]}" >/dev/null 2>&1 & ;;
        12) add_to_installer "${names[cur]}" "${isos[cur]}" && break ;;
        *)  break ;;
    esac
done
